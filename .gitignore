# deps & build
node_modules
dist/
*.tsbuildinfo

# logs
*.log
logs/

# --- TENANT DATA & SECRETS: never commit (platform/tenant boundary) ---
# Ignore EVERYTHING under tenant/ (agents, skills, scheduled-tasks, archived,
# store, secrets, memories) — it's per-install runtime data. Only the config
# example is kept so a fresh clone can seed itself.
/tenant/**
!/tenant/config/
!/tenant/config/overrides.example.json
!/tenant/GOALS.md.example

# env & secrets
.env
.env.*
!.env.example
*.key
*.pem
.vault-key
*-token
*.token
*oauth2*.json
*-sa.json
.dashboard-token

# os / editor
.DS_Store
*.swp

# python tooling byproducts (tools/oomwatch, tools/modal-sweeper) — never source
__pycache__/
*.pyc

# in-place edit backups. These are point-in-time copies of live scripts; committing them
# freezes a stale variant next to the real one and the next reader cannot tell which is
# authoritative. Git already holds the history.
*.bak
*.bak-*
*.bak.*

# tools/modal-sweeper: RETIRED interim stopgap (2026-08-04), superseded by the in-engine
# session-hygiene sweeper (src/session/modal-sweeper.ts). Kept on disk as a MANUAL break-glass
# tool only, out of git by decision (Michael + Toby) — a committed stale duplicate could be run
# thinking it is the live path. Usage documented in the clear-agent-modal-safely skill.
/tools/modal-sweeper/
